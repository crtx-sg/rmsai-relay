# Copy to .env and adjust. .env is gitignored.

# --- Lean datastores (Phase 0) ---
REDIS_PORT=6379

NEO4J_USER=neo4j
NEO4J_PASSWORD=rmsai_dev_pw
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Telemetry broker (Phase 1) ---
MQTT_PORT=1883

# --- LLM serving (Phase 2/4/6) ---
OLLAMA_PORT=11434
# Orchestrator LLM: echo (deterministic, offline) | ollama (self-hosted local model)
LLM_PROVIDER=echo
OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3.2

# --- Embeddings (vector RAG + episodic memory) ---
# hashing (offline, deterministic) | bge (real, needs `uv sync --extra rag`) | auto
EMBEDDER=hashing
# Relevance gate: answer when the best passage's semantic similarity clears this, even if it shares
# few words with the question. Only discriminates under EMBEDDER=bge (hashing scores on- and
# off-topic queries alike, so there the word-overlap arm carries the gate).
KB_MIN_RELEVANCE=0.60
# When the operational regexes miss a question that is plainly about a bed/patient/event, ask the
# LLM which graph template was meant (kb/graph/llm_router.py; inspect with `python -m cli.kb_route
# --llm "<question>"`). It picks a name from a fixed menu and never supplies a patient/event id —
# those come from session scope. Costs one model call on such a miss (~6s on llama3.2:3b, warm), so
# it is off by default: worth enabling for chat, think twice for the realtime voice loop.
KB_LLM_ROUTER=false
BGE_MODEL=BAAI/bge-small-en-v1.5

# Episodic recall: condition free-text answers on recalled past Q&A. Off by default (answers stay
# grounded in the live KB + the current conversation only). Set true to enable cross-session recall.
# EPISODIC_RECALL=false

# --- De-identification (before any model call) ---
DEID_BACKEND=regex            # regex (offline) | presidio (NLP) | auto (presidio, fall back to regex)
DEID_SPACY_MODEL=en_core_web_lg   # spaCy NER model for presidio (or en_core_web_sm for a light install)

# --- Voice STT/TTS (real audio path via the LiveKit agent) ---
STT_BACKEND=stub     # stub | whisper | elevenlabs
TTS_BACKEND=stub     # stub | piper | elevenlabs
WHISPER_MODEL=base.en          # faster-whisper model, e.g. tiny.en (English-only, fastest)
STT_LANGUAGE=en                # force STT language (ISO 639-1); blank or "auto" = auto-detect
# STT_INITIAL_PROMPT=          # override Whisper vocab biasing (defaults to clinical terms, G15)
PIPER_VOICE_PATH=

# ElevenLabs (cloud STT "Scribe" + TTS) — accuracy/latency benchmarking on SYNTHETIC data ONLY.
# Audio/text leaves this host to a third party; NEVER use with real PHI (hard rules #4/#5).
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB   # premade voice ("Adam"); free-tier usable. Library/
#   some premade voices (e.g. "Rachel") require a paid plan (402 paid_plan_required).
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5     # low-latency TTS model
# ELEVENLABS_STT_MODEL=scribe_v1
# ELEVENLABS_TTS_SAMPLE_RATE=22050           # 16000 | 22050 | 24000 | 44100

# LiveKit — self-hosted (ws://localhost:7880) OR LiveKit Cloud (wss://<project>.livekit.cloud).
# Used for inbound + outbound voice. Get key/secret from the LiveKit Cloud dashboard.
LIVEKIT_URL=ws://localhost:7880
# Browser-facing LiveKit URL the app connects to (Phase 9 public deploy). Leave blank for localhost
# (falls back to LIVEKIT_URL). Set to the public wss:// ingress when the app runs behind the edge.
# LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_TRUNK_ID=          # outbound SIP trunk id (Cloud Telephony) for cli.outbound --caller livekit
LIVEKIT_SIP_ROOM=rmsai-outbound
# On-demand phone call (cli.call): one room per call, `<prefix><call-id>`. Same prefix the inbound
# dispatch rule routes to, so both legs of the phone pipeline land in the same shape of room.
LIVEKIT_CALL_ROOM_PREFIX=rmsai-call-
# Call safety rails. Ringing timeout bounds how long an unanswered call holds a trunk channel; max
# duration is the backstop for a call answered by voicemail and then billed until someone notices.
SIP_RINGING_TIMEOUT_S=30
SIP_MAX_CALL_DURATION_S=600
# On worker startup, auto re-dispatch the agent into live rmsai-inbox-* rooms that lost their agent
# (e.g. after a worker restart) so the app doesn't need a re-login. Idempotent. See cli.dispatch.
LIVEKIT_REDISPATCH_ON_START=true
# livekit-agents binds a health-check HTTP server on this port. Only change it to run two workers
# side by side — e.g. the Docker `voice-worker` service (which defaults to 8091, since host
# networking would otherwise collide with a worker you run by hand on 8081).
# LIVEKIT_WORKER_HTTP_PORT=8081

# --- Voice interaction behaviour ---
# Companion app: on selecting a worklist row, speak that event's stored report summary aloud (in
# addition to scoping chat). The spoken text is the Report node's summary — no model call.
INBOX_SPEAK_ON_SELECT=true
# Require the wake word ("hey vios") to open a follow-up audio turn in the SIP/playground Q&A. Set
# false to answer EVERY authenticated audio turn — the escape hatch when STT mishears the
# out-of-vocab brand word. The companion app already bypasses this (the app controls the mic).
AUDIO_WAKE_REQUIRED=true

# --- Voice / media (Phase 5+) ---
LIVEKIT_PORT=7880
LIVEKIT_RTC_PORT=7881

# --- POC behaviour defaults (see common/config.py) ---
FP_SUPPRESS_MIN_CONFIDENCE=0.80
LOW_CONFIDENCE_CAVEAT=0.60
INBOUND_AUTH_PIN=1234

# --- Outbound calling / texting (Phase 7) ---
OUTBOUND_ENABLED=false
OUTBOUND_CALL_NUMBER=          # the predefined on-call number (event alerts AND `cli.call`)
OUTBOUND_FROM=                 # caller ID: SMS "from", and the SIP from-number on every call.
                               # Most carrier trunks reject a call presenting no valid from-number.
OUTBOUND_MIN_CRITICALITY=High
# A non-normal (arrhythmia) event is only asserted AS A RHYTHM if the model's confidence is at/above
# this. Below it: withheld when the vitals are calm (event still persisted, only the alert is
# suppressed), or re-based as a VITALS-DRIVEN alert — leading with the vital, rhythm marked
# unconfirmed — when MEWS/trends warrant attention. Vitals never raise this bar.
OUTBOUND_MIN_ARRHYTHMIA_CONFIDENCE=0.60
OUTBOUND_MAX_RETRIES=2
OUTBOUND_RETRY_DELAY_S=30

# Real SMS delivery (only needed for `cli.outbound --channel text --notifier twilio`)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# (the SMS "from" number uses OUTBOUND_FROM above)

# --- Companion app dispatch (Phase 9) ---
# Where a critical event is delivered: app (inbox push only) | call (per-event SIP/voice/text only)
# | app+call (both). The criticality gate is unchanged; this only picks the surface(s).
DISPATCH_MODE=app+call
# Facility the inbox room is scoped to; the app joins rmsai-inbox-<HOSPITAL_ID>.
HOSPITAL_ID=

# --- ECG classifier ---
# Checkpoint(s) for the arrhythmia model. Unset => the deterministic StubECGModel (no weights
# needed; every Phase 0/1 test runs this way). Several paths load as ONE softmax-averaging
# ensemble. The class head, lead order and filter preset are read from the checkpoint itself.
#
# models/real_v2 is the real-ECG release: 13 classes, `default` filter preset, trained on
# ecg_sigma ecgpkg v2. The 5-fold ensemble is the recommended artifact (5 CPU forward passes per
# event); fold0/best_model.pt alone is the cheaper single-model fallback.
# Weights are gitignored on both sides — run `make weights` first.
#
# ECG_CHECKPOINTS=external/ecgtranscnn/models/real_v2/fold0.pt external/ecgtranscnn/models/real_v2/fold1.pt external/ecgtranscnn/models/real_v2/fold2.pt external/ecgtranscnn/models/real_v2/fold3.pt external/ecgtranscnn/models/real_v2/fold4.pt
#
# Single-model fallback:
# ECG_CHECKPOINTS=external/ecgtranscnn/models/real_v2/best_model.pt
#
# NOTE: the simulator checkpoints (models/best_model.pt, noise_robust/, avblock_fix/) have a
# 16-class head and score 10-26% on real ECG. Use them only with simulator-generated HDF5.
#
# ecg_sigma training package that cli.real_samples draws held-out real-ECG events from. It must be
# the package ECG_CHECKPOINTS was trained on (real_v2 -> ecg_pkg_v2); pick checks the manifest.
# ECGPKG_DIR=../ecg_sigma/packages/ecg_pkg_v2

# ECG strip plots — producer renders each event ECG lead to {PLOT_DIR}/<event_id>.png (gitignored)
# ECG_PLOT_ENABLED=true
# PLOT_DIR=data/plots
