# Second hospital stack (h2): sourced by `make demo-phone-up` / `make h2-up` / `make docker-down`
# and passed to compose project `infra-h2`. Its own Redis/Neo4j/Qdrant/consumer/workers/gateway on
# these ports; LiveKit (local) and the model server are shared with h1. Site policy and phone
# numbers live in config/hospitals/h2.yaml (gitignored). No secrets here.
HOSPITAL_ID=h2
REDIS_PORT=6380
NEO4J_HTTP_PORT=7475
NEO4J_BOLT_PORT=7688
QDRANT_HTTP_PORT=6335
QDRANT_GRPC_PORT=6336
REDIS_URL=redis://localhost:6380/0
NEO4J_URI=bolt://localhost:7688
QDRANT_URL=http://localhost:6335
GATEWAY_PORT=8090
LIVEKIT_WORKER_HTTP_PORT=8093
LIVEKIT_SIP_WORKER_HTTP_PORT=8084
# MUST differ from h1's (rmsai-agent / rmsai-agent-phone): both register with the same LiveKit
# projects, and a shared name lets h1's call be answered by h2's worker (wrong patient data).
LIVEKIT_AGENT_NAME=rmsai-agent-h2
LIVEKIT_SIP_AGENT_NAME=rmsai-agent-phone-h2
AUDIT_LOG_PATH=data/audit-h2.jsonl
# Japanese alert (outbound.alert_language: ja in config/hospitals/h2.yaml): ElevenLabs "Sakura" and
# a multilingual model (eleven_flash_v2 is English-only). STT stays English: the clinician replies
# "yes" / "acknowledge" and asks follow-ups in English.
ELEVENLABS_VOICE_ID=EGPLqH9Wz2tNLu58EJVR
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
