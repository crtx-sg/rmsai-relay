logs:
docker compose -f infra/docker-compose.yml logs -f consumer
docker compose -f infra/docker-compose.yml logs -f --timestamps --tail=0 consumer     | grep --line-buffered -E '\[(event|skip|consume|outbound|call|webrtc)\]|->|poison|Error'
docker compose -f infra/docker-compose.yml --profile telephony logs -f --timestamps --tail=0 voice-worker-phone     | grep --line-buffered -E 'received job|joined room|caller answered|caller heard|greeting|stt transcript|PIN|speaking event alert|reply:|acknowledg|barge-in|ignoring filler|\[latency\]|blocked|gate timed out|Error'

docker compose -f infra/docker-compose.yml logs -f --timestamps --tail=0 voice-worker     | grep --line-buffered -E 'stt transcript|text chat|ptt|reply|\[latency\]|barge-in|Error'

# to see the speech to text and text to speech transcibe..
docker logs -f --tail 0 infra-voice-worker-phone-1 2>&1 \
    | grep --line-buffered -E "stt: ->|\[worker\] (heard|reply|speaking)|\[voice\]"

  That shows:
  - stt: -> '…': the raw transcript.
  - heard: '…': what was passed to the handler.
  - reply: '…': the KB-grounded answer, before TTS.
  - speaking greeting.
  - [voice] PIN accepted and speaking event alert for PT….

--
  To monitor from the command line after Run test:

  # The conversations on both phones, each line tagged [h1] / [h2]
  make phone-transcript HOSPITAL=all

  # Gate, queue, dial and retry/SMS lines: h1, then h2 (one terminal each)
  docker compose -f infra/docker-compose.yml -p infra    logs -f --tail=0 consumer
  docker compose -f infra/docker-compose.yml -p infra-h2 logs -f --tail=0 consumer
