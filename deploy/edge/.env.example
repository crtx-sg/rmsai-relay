# Public edge config. Copy to .env and adjust.

# Port the edge listens on (maps to container :80).
EDGE_HTTP_PORT=8081

# The on-prem gateway (cli.gateway), as reachable FROM the edge container.
#   Local test (edge + gateway same host):  http://host.docker.internal:8080
#   Public (edge on public host):           http://<gateway-private-ip>:8080  (over your VPN/tunnel)
GATEWAY_UPSTREAM=http://host.docker.internal:8080

# --- TLS (public step; see templates/default.conf.template + docker-compose.yml) ---
# EDGE_HTTPS_PORT=8443

# NOTE: the browser's LiveKit URL is NOT set here — it comes from the gateway's LIVEKIT_PUBLIC_URL
# (returned by POST /session). Set LIVEKIT_PUBLIC_URL in the gateway's .env to the public wss:// ingress.
