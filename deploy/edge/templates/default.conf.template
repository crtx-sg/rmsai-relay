# Public edge for the rmsai companion app.
#   /                       -> the static app (served here)
#   /session /ack /artifact -> reverse-proxied to the on-prem gateway (kept private)
#
# The nginx image envsubst's ${GATEWAY_UPSTREAM} at startup; nginx's own $host/$remote_addr/etc.
# are NOT in the environment, so they survive untouched.

server {
    listen 80;
    server_name _;

    root /srv/app;
    index index.html;

    # Static companion app (index.html, app.js, vendor/livekit-client…).
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Gateway API. The gateway stays private on-prem; the browser reaches it ONLY through this proxy.
    # (Artifact links in inbox messages are relative "/artifact/<token>", so they resolve here.)
    location ~ ^/(session|ack|artifact)(/|$) {
        proxy_pass ${GATEWAY_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}

