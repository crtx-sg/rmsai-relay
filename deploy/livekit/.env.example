# Public LiveKit config. Copy to .env and set real values (go-public step).

# Real API key/secret — generate strong random values (NOT the dev devkey/secret).
# These must match: the gateway's LIVEKIT_API_KEY/LIVEKIT_API_SECRET (on-prem) and the tokens it mints.
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME_LONG_RANDOM

# Also edit the `# EDIT` lines in livekit.public.yaml (domain, node_ip) and, if using coturn,
# coturn/turnserver.conf (external-ip, realm, static-auth-secret). Drop TLS certs into ./certs.
#
# Then set the gateway's LIVEKIT_PUBLIC_URL to the public wss:// ingress, e.g.:
#   LIVEKIT_PUBLIC_URL=wss://livekit.example.com
